  <div class="rf-lightbox" id="lightbox" hidden>
    <button type="button" class="rf-lightbox-close" id="lightboxClose" aria-label="Close">&times;</button>
    <div class="rf-lightbox-content">
      <img id="lightboxImage" class="rf-lightbox-image" src="" alt="" />
      <div class="photo-placeholder rf-lightbox-placeholder" id="lightboxPlaceholder" hidden><span id="lightboxCaption">Photo coming soon</span></div>
    </div>
  </div>

  <script>
    (function () {
      var lightbox = document.getElementById('lightbox');
      var lightboxImage = document.getElementById('lightboxImage');
      var lightboxPlaceholder = document.getElementById('lightboxPlaceholder');
      var lightboxCaption = document.getElementById('lightboxCaption');
      var lightboxClose = document.getElementById('lightboxClose');

      function openLightbox(caption, image) {
        if (image) {
          lightboxImage.src = image;
          lightboxImage.alt = caption || '';
          lightboxImage.hidden = false;
          lightboxPlaceholder.hidden = true;
        } else {
          lightboxCaption.textContent = caption || 'Photo coming soon';
          lightboxImage.hidden = true;
          lightboxPlaceholder.hidden = false;
        }
        lightbox.hidden = false;
      }

      function closeLightbox() {
        lightbox.hidden = true;
      }

      document.querySelectorAll('.mosaic-item, .gallery-tile').forEach(function (el) {
        el.addEventListener('click', function () {
          openLightbox(el.getAttribute('data-caption'), el.getAttribute('data-image'));
        });
      });

      lightboxClose.addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) closeLightbox();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !lightbox.hidden) closeLightbox();
      });

      var viewAllBtn = document.getElementById('viewAllPhotosBtn');
      viewAllBtn.addEventListener('click', function () {
        document.getElementById('gallery').scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    })();
  </script>
