  <div class="lk-lightbox" id="lkLightbox" hidden>
    <button type="button" class="lk-lightbox-close" id="lkLightboxClose" aria-label="Close">&times;</button>
    <img id="lkLightboxImg" src="" alt="" />
    <p class="lk-lightbox-cap" id="lkLightboxCap"></p>
  </div>

  <script>
    (function () {
      var tabs = document.querySelectorAll('.lk-tab');
      var panels = document.querySelectorAll('.lk-tab-panel');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
          });
          panels.forEach(function (p) {
            p.hidden = true;
          });
          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');
          var panel = document.getElementById(tab.getAttribute('aria-controls'));
          if (panel) panel.hidden = false;
        });
      });
    })();

    (function () {
      var box = document.getElementById('lkLightbox');
      var img = document.getElementById('lkLightboxImg');
      var cap = document.getElementById('lkLightboxCap');
      var closeBtn = document.getElementById('lkLightboxClose');

      function open(full, caption) {
        img.src = full;
        img.alt = caption || '';
        cap.textContent = caption || '';
        box.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function close() {
        box.hidden = true;
        img.src = '';
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.lk-gallery-tile').forEach(function (el) {
        el.addEventListener('click', function () {
          open(el.getAttribute('data-full'), el.getAttribute('data-cap'));
        });
      });
      closeBtn.addEventListener('click', close);
      box.addEventListener('click', function (e) {
        if (e.target === box) close();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !box.hidden) close();
      });
    })();
  </script>
