  <div class="cg-lightbox" id="cgLightbox" hidden>
    <button type="button" class="cg-lightbox-close" id="cgLightboxClose" aria-label="Close">&times;</button>
    <img id="cgLightboxImg" src="" alt="" />
    <p class="cg-lightbox-cap" id="cgLightboxCap"></p>
  </div>

  <script>
    (function () {
      var box = document.getElementById('cgLightbox');
      var img = document.getElementById('cgLightboxImg');
      var cap = document.getElementById('cgLightboxCap');
      var closeBtn = document.getElementById('cgLightboxClose');

      function open(full, caption) {
        img.src = full;
        img.alt = caption || '';
        cap.textContent = caption || '';
        box.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function close() {
        box.hidden = true;
        img.src = '';
        document.body.style.overflow = '';
      }

      document.querySelectorAll('#cgMosaic button, #cgGallery button').forEach(function (b) {
        b.addEventListener('click', function () {
          open(b.getAttribute('data-full'), b.getAttribute('data-cap'));
        });
      });
      closeBtn.addEventListener('click', close);
      box.addEventListener('click', function (e) { if (e.target === box) close(); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !box.hidden) close();
      });
    })();
  </script>
