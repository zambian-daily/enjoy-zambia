---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  {
    title: 'Camping & Outdoors',
    href: '/camping-outdoor/',
    description: 'Campsite reviews, camping tips, and outdoor escapes around Zambia.',
  },
  {
    title: 'Festival',
    href: '/festival/',
    description: 'Local festival listings and event previews coming soon.',
  },
  {
    title: 'Lusaka Life',
    href: '/lusaka-life/',
    description: 'City guides, restaurants, and Lusaka lifestyle stories.',
  },
  {
    title: 'Travel',
    href: '/travel/',
    description: 'Travel advice and Zambia adventure planning resources.',
  },
];
---
<BaseLayout title="Enjoy Zambia" description="Enjoy Zambia — Zambia travel, festivals, Lusaka life, and camping outdoors.">
  <section class="hero">
    <div class="hero-image-frame">
      <img src="/images/hero_enjoyzambia.png" alt="Enjoy Zambia hero image" />
    </div>
    <div class="hero-tagline">
      <p>Discover Zambia's best camping spots, festivals, city life, and travel tips.</p>
    </div>
  </section>

  <section class="categories-section">
    <div class="container">
      <h2 class="section-title">Explore by category</h2>
      <div class="categories-grid">
        {categories.map((category) => (
          <a class="category-card" href={category.href}>
            <div class="category-icon">{category.title === 'Camping & Outdoors' ? '⛺' : category.title === 'Festival' ? '🎉' : category.title === 'Lusaka Life' ? '🏙️' : '✈️'}</div>
            <div class="category-name">{category.title}</div>
            <p class="category-count">{category.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
